{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build lab2",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-I",
                "include",
                "src/*.cpp",
                "-o",
                "app.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-NoProfile", "-Command"]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build and run lab2",
            "type": "shell",
            "command": "g++ -std=c++17 -I include src/*.cpp -o app.exe; if ($LASTEXITCODE -eq 0) { .\\app.exe }",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-NoProfile", "-Command"]
                }
            },
            "group": "test",
            "problemMatcher": ["$gcc"]
        }
    ]
}
