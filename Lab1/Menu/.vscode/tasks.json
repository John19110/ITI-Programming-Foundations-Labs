{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "-I",
                "include",
                "src/Main.cpp",
                "src/Menu.cpp",
                "src/Employee.cpp",
                "src/Color.cpp",
                "-o",
                "Menu"
            ],
            "windows": {
                "args": [
                    "-std=c++17",
                    "-g",
                    "-I",
                    "include",
                    "src/Main.cpp",
                    "src/Menu.cpp",
                    "src/Employee.cpp",
                    "src/Color.cpp",
                    "-o",
                    "Menu.exe"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "run",
            "type": "shell",
            "command": "./run.sh",
            "windows": {
                "command": "run.cmd",
                "args": []
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
